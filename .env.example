# Get a free token at https://envio.dev/app/api-tokens
ENVIO_API_TOKEN=

# Optional: DRPC key, used by the analytics package for ad-hoc on-chain reads
# (e.g. effects-API token-decimal lookups). Not required for the indexer itself.
ENVIO_DRPC_API_KEY=

# Local stack credentials. `envio dev` provides these automatically.
# Override here only when running `envio start` against your own infra.
ENVIO_CLICKHOUSE_HOST=http://localhost:8123
ENVIO_CLICKHOUSE_USERNAME=default
ENVIO_CLICKHOUSE_PASSWORD=testing
ENVIO_CLICKHOUSE_DATABASE=envio_sink
ENVIO_PG_HOST=localhost
ENVIO_PG_PORT=5433
ENVIO_PG_USER=postgres
ENVIO_PG_PASSWORD=testing
ENVIO_PG_DATABASE=envio-dev
TUI_OFF=true
